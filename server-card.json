{
  "name": "zeroidagent",
  "title": "ZeroID Agent Identity",
  "description": "A paid remote MCP for ZeroID, built to return verdicts, receipts, usage logs, and audit-ready JSON for agent and CI workflows.",
  "version": "1.0.0",
  "websiteUrl": "https://zeroidagent.clauxel.com/",
  "documentationUrl": "https://zeroidagent.clauxel.com/mcp/",
  "endpointUrl": "https://zeroidagent.clauxel.com/mcp",
  "transport": "streamable-http",
  "authentication": {
    "type": "bearer",
    "required": true,
    "header": "Authorization",
    "format": "Bearer <paid-token>"
  },
  "paidAccess": {
    "required": true,
    "checkoutUrl": "https://zeroidagent.clauxel.com/api/agent-checkout",
    "tokenStatusUrl": "https://zeroidagent.clauxel.com/api/mcp-token/status",
    "tokenClaimUrl": "https://zeroidagent.clauxel.com/api/mcp-token/claim",
    "defaultPlan": "team",
    "pricing": [
      {
        "id": "starter",
        "name": "Starter",
        "monthlyUsd": 39
      },
      {
        "id": "team",
        "name": "Team",
        "monthlyUsd": 129
      },
      {
        "id": "control",
        "name": "Control",
        "monthlyUsd": 449
      }
    ]
  },
  "tools": [
    {
      "name": "issue_agent_identity",
      "description": "ZeroID Agent Identity issue agent identity",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sample": {
            "type": "string",
            "description": "Workflow sample, schema, policy fixture, or agent output."
          },
          "context": {
            "type": "string",
            "description": "Optional review context."
          }
        },
        "required": [
          "sample"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "receipt_id": {
            "type": "string"
          },
